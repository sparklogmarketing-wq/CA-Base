---
import { site, headerNav } from '../config/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-baseline gap-2">
      <span class="text-lg font-bold tracking-tight text-brand-800">{site.name}</span>
      <span class="hidden text-xs font-medium uppercase tracking-widest text-slate-500 sm:inline">{site.tagline}</span>
    </a>
    <nav class="flex items-center gap-1 text-sm font-medium text-slate-600">
      {headerNav.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-3 py-2 hover:bg-brand-50 hover:text-brand-700',
            current === link.href && 'text-brand-700 bg-brand-50',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/apply-online"
        class="ml-2 rounded-md bg-brand-600 px-4 py-2 font-semibold text-white shadow-sm hover:bg-brand-700"
      >
        Consult Us
      </a>
    </nav>
  </div>
</header>
