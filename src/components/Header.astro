---
import { site, headerNav } from '../config/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <input type="checkbox" id="mobile-nav-toggle" class="peer sr-only" />
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-baseline gap-2">
      <span class="text-lg font-bold tracking-tight text-brand-800">{site.name}</span>
      <span class="hidden text-xs font-medium uppercase tracking-widest text-slate-500 sm:inline">{site.tagline}</span>
    </a>
    <nav class="hidden items-center gap-1 text-sm font-medium text-slate-600 md:flex">
      {headerNav.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-3 py-2 hover:bg-brand-50 hover:text-brand-700',
            current === link.href && 'text-brand-700 bg-brand-50',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/apply-online"
        class="ml-2 rounded-md bg-brand-600 px-4 py-2 font-semibold text-white shadow-sm hover:bg-brand-700"
      >
        Consult Us
      </a>
    </nav>
    <label
      for="mobile-nav-toggle"
      class="inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-slate-700 hover:bg-brand-50 hover:text-brand-700 md:hidden"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>
  <nav class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 peer-checked:block md:hidden">
    {headerNav.map((link) => (
      <a
        href={link.href}
        class:list={[
          'block rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-700',
          current === link.href && 'text-brand-700 bg-brand-50',
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href="/apply-online"
      class="mt-2 block rounded-md bg-brand-600 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
    >
      Consult Us
    </a>
  </nav>
</header>
