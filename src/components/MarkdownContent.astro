---
import { marked } from 'marked';

interface Props {
  content: string;
}

const { content } = Astro.props;
const html = await marked.parse(content);
---

<div
  class="prose prose-slate max-w-none prose-headings:scroll-mt-24 prose-a:text-brand-700 prose-a:font-medium hover:prose-a:text-brand-600"
  set:html={html}
/>