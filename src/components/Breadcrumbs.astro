---
interface Crumb {
  label: string;
  href: string;
}

const { crumbs } = Astro.props as { crumbs: Crumb[] };
---
{crumbs.length > 0 && (
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
    <ol class="flex flex-wrap items-center gap-1">
      {crumbs.map((c, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === crumbs.length - 1 ? (
            <span class="text-slate-700">{c.label}</span>
          ) : (
            <a href={c.href} class="hover:text-brand-700">{c.label}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
