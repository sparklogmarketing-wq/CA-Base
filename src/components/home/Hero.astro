---
interface Props {
  h1: string;
  description: string;
}

const { h1, description } = Astro.props;

const trustPoints = [
  'ICAI member firm',
  'Partner-supervised engagements',
  'Statutory deadline tracking',
];
---

<section class="bg-gradient-to-br from-brand-950 via-brand-800 to-brand-600">
  <div class="mx-auto max-w-6xl px-4 pb-24 pt-16 sm:pb-28 sm:pt-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-200">Chartered Accountants &middot; Bangalore</p>
    <h1 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-5xl">{h1}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-100">{description}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/apply-online"
        class="rounded-md bg-white px-6 py-3 font-semibold text-brand-800 shadow-sm transition-colors hover:bg-brand-50"
      >
        Consult Us
      </a>
      <a
        href="#services"
        class="rounded-md border border-white/40 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10"
      >
        Explore our services
      </a>
    </div>
    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-brand-100">
      {trustPoints.map((point) => (
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.3 3.3 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd" />
          </svg>
          {point}
        </li>
      ))}
    </ul>
  </div>
</section>
