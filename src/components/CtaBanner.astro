---
import { site } from '../config/site';

interface Props {
  city?: string;
}

const { city = 'Bangalore' } = Astro.props;
const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
---

<section class="mt-14 overflow-hidden rounded-2xl bg-gradient-to-r from-brand-950 via-brand-800 to-brand-600 px-6 py-10 text-center sm:px-10">
  <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Talk to our chartered accountants in {city}</h2>
  <p class="mx-auto mt-3 max-w-2xl leading-relaxed text-brand-100">
    Tell us what you need — an audit quotation, a GST registration, monthly accounting or a second opinion on a notice — and we will respond with a clear scope and fee.
  </p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
    <a
      href="/apply-online"
      class="rounded-md bg-white px-6 py-2.5 font-semibold text-brand-800 shadow-sm transition-colors hover:bg-brand-50"
    >
      Book a consultation
    </a>
    <a
      href={telHref}
      class="rounded-md border border-white/40 px-6 py-2.5 font-semibold text-white transition-colors hover:bg-white/10"
    >
      Call {site.phone}
    </a>
  </div>
</section>
