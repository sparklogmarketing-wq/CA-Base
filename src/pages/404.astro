---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you requested was not found." path="/404">
  <div class="mx-auto max-w-3xl py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">404</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900">Page not found</h1>
    <p class="mt-3 text-slate-600">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="mt-6 inline-block rounded-md bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">Back to home</a>
  </div>
</BaseLayout>
