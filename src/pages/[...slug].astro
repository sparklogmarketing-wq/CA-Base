---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MarkdownContent from '../components/MarkdownContent.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Hero from '../components/home/Hero.astro';
import StatsStrip from '../components/home/StatsStrip.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import GalleryMarquee from '../components/home/GalleryMarquee.astro';
import PartnersMarquee from '../components/home/PartnersMarquee.astro';
import { pages, fill, fillPage, cleanLabel, stripFaqSection, type Page } from '../lib/pages';
import { cities, placeholders, clusterHubs } from '../config/site';

export function getStaticPaths() {
  const routes = [];
  for (const page of pages) {
    if (page.fm.isCityTemplate) {
      for (const city of cities) {
        const displayVars = { ...placeholders, city: city.name };
        const slugVars = { ...placeholders, city: city.slug };
        const slug = fill(page.fm.slug, slugVars).replace(/^\//, '');
        routes.push({ params: { slug }, props: { page, displayVars, slugVars, city } });
      }
    } else {
      const seed = cities[0];
      const displayVars = { ...placeholders, city: seed.name };
      const slugVars = {
        ...Object.fromEntries(Object.entries(placeholders).map(([k, v]) => [k, v.toLowerCase()])),
        city: seed.slug,
      };
      const s = fill(page.fm.slug, slugVars);
      const slug = s === '/' ? undefined : s.replace(/^\//, '');
      routes.push({ params: { slug }, props: { page, displayVars, slugVars } });
    }
  }
  return routes;
}

interface Props {
  page: Page;
  displayVars: Record<string, string>;
  slugVars: Record<string, string>;
  city?: (typeof cities)[number];
}

const { page, displayVars, slugVars, city } = Astro.props as Props;
const resolved = fillPage(page, displayVars, slugVars);
const { fm, content } = resolved;

const layout = fm.layout ?? 'article';
const isHome = layout === 'home';
const isConversion = layout === 'conversion';

const crumbs = [{ label: 'Home', href: '/' }];
if (city) {
  crumbs.push({ label: `CA Firm in ${city.name}`, href: `/ca-firm-in-${city.slug}` });
} else if (fm.cluster !== 'Core') {
  const hubSlug = clusterHubs[fm.cluster];
  if (hubSlug && hubSlug !== fm.slug) {
    const hub = pages.find((p) => p.fm.slug === hubSlug);
    crumbs.push({
      label: hub ? cleanLabel(hub.fm.pageName, displayVars) : cleanLabel(fm.cluster, displayVars),
      href: hubSlug,
    });
  }
}
crumbs.push({ label: cleanLabel(fm.pageName, displayVars) || fm.pageName, href: fm.slug });

const path = Astro.url.pathname === '' ? '/' : Astro.url.pathname;

// FAQ prose is duplicated with the frontmatter list; render the accordion once instead.
const bodyContent = stripFaqSection(content);
---
<BaseLayout
  title={fm.title}
  description={fm.description}
  path={path}
  faqs={fm.faqs}
  breadcrumbs={crumbs}
  pageType={fm.pageType}
  wide={isHome}
>
  {isHome && (
    <>
      <Hero h1={fm.h1} description={fm.description} />
      <StatsStrip />
      <ServiceCards />
      <GalleryMarquee />
      <PartnersMarquee />
      <div class="mx-auto max-w-6xl px-4 pb-16">
        <FaqAccordion faqs={fm.faqs} />
        <CtaBanner city={displayVars.city} />
      </div>
    </>
  )}
  {!isHome && (
    <article class="mx-auto max-w-3xl">
      {!isConversion && <Breadcrumbs crumbs={crumbs} />}
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-600">{cleanLabel(fm.cluster, displayVars)} / {fm.pageType}</p>
      <h1 class="mb-6 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{fm.h1}</h1>
      {isConversion && <EnquiryForm />}
      <MarkdownContent content={bodyContent} />
      <FaqAccordion faqs={fm.faqs} />
      <CtaBanner city={displayVars.city} />
    </article>
  )}
</BaseLayout>
